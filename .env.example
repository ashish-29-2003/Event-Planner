# Utsav (उत्सव) Environment Configuration

# Google Gemini API Key (Required for AI generation; if omitted, demo fallback is used)
GEMINI_API_KEY=your-gemini-api-key-here

# Server Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=True
ENVIRONMENT=development

# Optional: Google Maps Platform API Key (for live place lookup)
GOOGLE_MAPS_API_KEY=
