# Samaroh (समारोह) Environment Configuration

# Google Gemini API Key (Required for live GenAI generation; if omitted, offline seed fallback is used)
GEMINI_API_KEY=

# Server Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=True
ENVIRONMENT=development

# Python Encoding for Windows Console compatibility
PYTHONIOENCODING=utf-8

# Optional: Google Maps Platform API Key (for venue & local place lookup)
GOOGLE_MAPS_API_KEY=
