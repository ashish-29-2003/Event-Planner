# ==============================================================================
# Samaroh (समारोह) - GenAI Celebration & Event Planner
# Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime & Environment
# ------------------------------------------------------------------------------
# Runtime environment: 'development', 'staging', or 'production'
ENVIRONMENT=development

# Enable local debug logs and auto-reload (set False in production)
DEBUG=True

# Network binding host and port
HOST=127.0.0.1
PORT=8000

# Console character encoding (ensures Devanagari script renders properly on Windows)
PYTHONIOENCODING=utf-8

# Allowed CORS origins (comma-separated list, e.g. "https://utsav-ai.netlify.app,http://localhost:8000" or "*")
CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# 2. Google Gemini API (Core Generative AI Engine)
# ------------------------------------------------------------------------------
# Google AI Studio / Gemini API Key (Required for live multi-agent synthesis)
# If omitted or quota exhausted, the system automatically degrades to curated seed models
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Gemini model identifier (default: gemini-2.0-flash for high-speed multi-agent synthesis)
GEMINI_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# 3. Google Maps Platform (Venue & Vendor Discovery)
# ------------------------------------------------------------------------------
# Google Cloud Maps Places API key (proxied securely via backend /api/places/search)
# If omitted, Samaroh falls back to the curated regional Indian vendor registry
GOOGLE_MAPS_API_KEY=AIzaSyYourGoogleMapsApiKeyHere

# ------------------------------------------------------------------------------
# 4. Firebase Authentication & App Check Security
# ------------------------------------------------------------------------------
# Google Cloud / Firebase Project ID
FIREBASE_PROJECT_ID=samaroh-celebrations

# Optional filesystem path to Firebase Service Account JSON credentials
FIREBASE_CREDENTIALS_PATH=

# Optional raw Firebase Service Account JSON string (ideal for container platforms like Render)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Enforce Firebase ID Token Bearer verification on mutating endpoints (True/False)
ENABLE_AUTH_ENFORCEMENT=True

# Enforce Firebase App Check on public AI plan generation routes (True/False)
ENABLE_APP_CHECK=True

# App Check mode: 'enforcing' (strictly blocks missing/invalid tokens) or 'monitor' (logs warnings without blocking)
APP_CHECK_MODE=monitor

# App Check developer bypass token allowance (must be False in production)
APP_CHECK_DEV_BYPASS=False

# ------------------------------------------------------------------------------
# 5. Persistence & Storage Backend
# ------------------------------------------------------------------------------
# Active persistence engine: 'firestore', 'local', or 'memory'
# In production, must be 'firestore'; local and memory backends are for local dev & testing
STORAGE_BACKEND=local

# ------------------------------------------------------------------------------
# 6. Rate Limiting & Abuse Prevention
# ------------------------------------------------------------------------------
# Maximum AI generation requests allowed per IP / user per rolling window
RATE_LIMIT_AI_REQUESTS=25

# Rolling rate limit window duration in seconds (e.g. 600 = 10 minutes)
RATE_LIMIT_WINDOW_SECONDS=600
