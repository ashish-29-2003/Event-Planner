rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper authorization functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Default deny for all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Public / demo celebrations are read-only for guest evaluation
    match /public_events/{eventId} {
      allow read: if true;
      allow write: if false;

      match /{subcollection}/{documentId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // Strict multi-tenant isolation under /users/{userId}
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /events/{eventId} {
        allow read, write: if isOwner(userId);

        match /budgets/{budgetId} {
          allow read, write: if isOwner(userId);
        }

        match /tasks/{taskId} {
          allow read, write: if isOwner(userId);
        }

        match /vendors/{vendorId} {
          allow read, write: if isOwner(userId);
        }

        match /ideas/{ideaId} {
          allow read, write: if isOwner(userId);
        }

        match /guests/{guestId} {
          allow read, write: if isOwner(userId);
        }
      }
    }
  }
}
